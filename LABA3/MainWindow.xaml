<Window x:Class="LABA3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №3 — Інтерполяція" 
        Height="650" Width="900" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Параметри та вибір графіків" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Крок h1:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding H1, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0" Height="25" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Крок h2:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding H2, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0" Height="25" VerticalContentAlignment="Center"/>

                    <Button Content="Обчислити" Command="{Binding CalculateCommand}" Width="100" Height="25" Margin="0,0,20,0"/>

                    <CheckBox Content="Лінійна (Червона)" IsChecked="{Binding ShowLinear}" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Red" FontWeight="Bold"/>
                    <CheckBox Content="Ерміт (Синя)" IsChecked="{Binding ShowHermite}" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Blue" FontWeight="Bold"/>
                    <CheckBox Content="Еталон sin(x) (Зелена)" IsChecked="{Binding ShowExact}" VerticalAlignment="Center" Foreground="Green" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" Margin="0,5,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Header="Графіки інтерполяції" Grid.Row="1" Margin="0,0,0,10">
            <Border BorderBrush="LightGray" BorderThickness="1" Background="#FAFAFA">
                <Canvas ClipToBounds="True">
                  
                    <Line X1="0" Y1="150" X2="850" Y2="150" Stroke="LightGray" StrokeDashArray="2 2" StrokeThickness="1"/>

                   
                    <Polyline Points="{Binding ExactPoints}" Stroke="Green" StrokeThickness="1.5" 
                              Visibility="{Binding ShowExact, Converter={StaticResource BoolToVis}}"/>

                    <Polyline Points="{Binding LinearPoints}" Stroke="Red" StrokeThickness="2" StrokeDashArray="3 2"
                              Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}"/>

                    <Polyline Points="{Binding HermitePoints}" Stroke="Blue" StrokeThickness="2"
                              Visibility="{Binding ShowHermite, Converter={StaticResource BoolToVis}}"/>
                </Canvas>
            </Border>
        </GroupBox>

    
        <GroupBox Header="Графік абсолютної похибки (Ерміт)" Grid.Row="2">
            <Border BorderBrush="LightGray" BorderThickness="1" Background="#FFF5F5">
                <Canvas ClipToBounds="True">
                    <Polyline Points="{Binding ErrorPoints}" Stroke="Magenta" StrokeThickness="2"/>
                </Canvas>
            </Border>
        </GroupBox>
    </Grid>
</Window>